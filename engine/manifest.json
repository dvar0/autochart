{
  "schemaVersion": 1,
  "engineVersion": "2026.06.16-cross-platform-runtime",
  "targetMatrix": "../config/supported-targets.json",
  "entry": {
    "command": "node",
    "args": [
      "{engineRoot}/bin/autochart-engine.cjs"
    ]
  },
  "generators": [
    {
      "id": "autochart.fretformer.v1-onnx",
      "label": "Fretformer",
      "titleTag": "Fretformer",
      "description": "Fully-local ONNX chart engine (Demucs separation -> Beat This detection -> transcriber) running entirely on onnxruntime-node. GPU-accelerated via WebGPU with automatic CPU fallback; no Python at runtime.",
      "status": "stable",
      "platforms": [
        "linux",
        "darwin",
        "win32"
      ],
      "capabilities": {
        "difficulties": [
          "easy",
          "medium",
          "hard",
          "expert"
        ],
        "sustains": "never-strip",
        "triples": true,
        "requiresGpu": false,
        "usesTimingCache": true,
        "usesStemCache": true,
        "descriptorKnobs": true
      },
      "models": {
        "onnxFolder": "fretformer-v1"
      },
      "runtime": {
        "backend": "onnxruntime-node",
        "executionProvider": "cpu",
        "devices": {
          "linux": { "demucs": "cpu" },
          "darwin": { "demucs": "cpu" },
          "win32": { "demucs": "cpu" }
        }
      }
    },
    {
      "id": "autochart.fretformer.v2-onnx",
      "label": "Fretformer 2",
      "titleTag": "Fretformer 2",
      "badge": "New",
      "description": "Six-stem separation, style knobs, and solo and section markers. Comes with Fill-in.",
      "status": "stable",
      "platforms": [
        "linux",
        "darwin",
        "win32"
      ],
      "capabilities": {
        "difficulties": [
          "easy",
          "medium",
          "hard",
          "expert"
        ],
        "sustains": "never-strip",
        "triples": true,
        "requiresGpu": false,
        "usesTimingCache": true,
        "usesStemCache": true,
        "descriptorKnobs": ["speed", "chords", "hopos", "taps", "movement"],
        "structureMarkers": ["solos", "sections"]
      },
      "separation": {
        "model": "htdemucs_6s",
        "stemSet": "htdemucs_6s",
        "cacheSubdir": "stems_htdemucs_6s",
        "stems": ["drums", "bass", "vocals", "guitar", "other"]
      },
      "models": {
        "onnxFolder": "fretformer-v2"
      },
      "runtime": {
        "backend": "onnxruntime-node",
        "executionProvider": "cpu",
        "devices": {
          "linux": { "demucs": "cpu" },
          "darwin": { "demucs": "cpu" },
          "win32": { "demucs": "cpu" }
        }
      }
    },
    {
      "id": "autochart.fretformer.v2-inpaint-onnx",
      "label": "Fretformer 2 Inpaint",
      "titleTag": "Fretformer 2 Inpaint",
      "badge": "New",
      "description": "Fretformer 2's Inpaint model: rewrites picked bars, and can also write whole charts. Comes with Fretformer 2.",
      "status": "experimental",
      "platforms": [
        "linux",
        "darwin",
        "win32"
      ],
      "capabilities": {
        "difficulties": [
          "easy",
          "medium",
          "hard",
          "expert"
        ],
        "sustains": "never-strip",
        "triples": true,
        "requiresGpu": false,
        "usesTimingCache": true,
        "usesStemCache": true,
        "descriptorKnobs": ["speed", "chords", "hopos", "taps", "movement"],
        "structureMarkers": ["solos", "sections"],
        "inpaint": true
      },
      "separation": {
        "model": "htdemucs_6s",
        "stemSet": "htdemucs_6s",
        "cacheSubdir": "stems_htdemucs_6s",
        "stems": ["drums", "bass", "vocals", "guitar", "other"]
      },
      "models": {
        "onnxFolder": "fretformer-v2-inpaint"
      },
      "runtime": {
        "backend": "onnxruntime-node",
        "executionProvider": "cpu",
        "devices": {
          "linux": { "demucs": "cpu" },
          "darwin": { "demucs": "cpu" },
          "win32": { "demucs": "cpu" }
        }
      }
    },
    {
      "id": "autochart.fretformer.v2-lite-onnx",
      "label": "Fretformer 2 Lite",
      "titleTag": "Fretformer 2 Lite",
      "badge": "Lite",
      "description": "For slower computers: skips stem separation, so it follows the melody less closely. Has its own Fill-in.",
      "status": "experimental",
      "platforms": [
        "linux",
        "darwin",
        "win32"
      ],
      "capabilities": {
        "difficulties": [
          "easy",
          "medium",
          "hard",
          "expert"
        ],
        "sustains": "never-strip",
        "triples": true,
        "requiresGpu": false,
        "usesTimingCache": true,
        "usesStemCache": false,
        "descriptorKnobs": ["speed", "chords", "hopos", "taps", "movement"],
        "structureMarkers": ["solos", "sections"],
        "inpaint": true
      },
      "separation": {
        "model": "htdemucs_6s",
        "stemSet": "htdemucs_6s",
        "cacheSubdir": "stems_htdemucs_6s",
        "stems": ["drums", "bass", "vocals", "guitar", "other"]
      },
      "models": {
        "onnxFolder": "fretformer-v2-lite"
      },
      "runtime": {
        "backend": "onnxruntime-node",
        "executionProvider": "cpu"
      }
    }
  ]
}
